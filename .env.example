# Supabase(账号 + Postgres 真相源)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis(仅用于限流,不再存业务数据)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 限流上限(由 Node 应用读取)
PUBLISH_LIMIT_PER_DAY=10
CLAIM_LIMIT_PER_DAY=10
PUBLISH_LIMIT_PER_HOUR=10
# 每 IP 每日注册上限(防脚本批量注册)
REGISTER_LIMIT_PER_DAY_PER_IP=3

# 信用上限属于「数据库设置」,不走 .env —— 应用不读它们。
# 在 Supabase SQL Editor 用 GUC 配置(留空则用函数内默认:种子 1、每日封顶 5):
#   alter database postgres set app.seed_credits = '1';
#   alter database postgres set app.earn_cap_per_day = '5';
