# Supabase(账号 + Postgres 真相源)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis(仅用于限流,不再存业务数据)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 限流上限(由 Node 应用读取)
PUBLISH_LIMIT_PER_DAY=10
CLAIM_LIMIT_PER_DAY=10
PUBLISH_LIMIT_PER_HOUR=10
# 公共大厅读取限流(每 IP 每分钟)
HALL_LIMIT_PER_MINUTE=120
# 每 IP 每日注册上限(防脚本批量注册)
REGISTER_LIMIT_PER_DAY_PER_IP=3

# 每日赚取封顶属于「数据库设置」,不走 .env —— 应用不读它。
# 审核通过固定发放 3 点信用；每日赚取封顶可在 Supabase SQL Editor 配置:
#   alter database postgres set app.earn_cap_per_day = '5';

# 可选:本地/CI 集成测试专用,必须指向隔离测试项目
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
# TEST_UPSTASH_REDIS_REST_URL=
# TEST_UPSTASH_REDIS_REST_TOKEN=
# TEST_REDIS_PREFIX=test-
